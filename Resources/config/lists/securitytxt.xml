<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>securitytxt</key>

    <!-- ponytail: multi-value fields are JSON columns and not readable in a table, so the list shows only Expires -->
    <properties>
        <property name="id" visibility="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>BitExpert\Sulu\SecuritytxtBundle\Entity\Securitytxt</entity-name>
        </property>

        <!-- filter only: the admin list is restricted to the current webspace -->
        <property name="webspace_key" visibility="never" translation="securitytxt.webspace_key">
            <field-name>webspace_key</field-name>
            <entity-name>BitExpert\Sulu\SecuritytxtBundle\Entity\Securitytxt</entity-name>
        </property>

        <property name="expires" visibility="always" translation="securitytxt.expires">
            <field-name>expires</field-name>
            <entity-name>BitExpert\Sulu\SecuritytxtBundle\Entity\Securitytxt</entity-name>
        </property>
    </properties>
</list>
